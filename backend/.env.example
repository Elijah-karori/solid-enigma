# Copy to .env (never commit it) and fill in. Load with:  set -a; source .env; set +a
JWT_SECRET=                 # REQUIRED, 32+ random chars:  openssl rand -base64 48
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false         # set true behind HTTPS in production
AUTH_REQUIRE_OTP=true       # emailed 6-digit code after the password
ACCESS_TTL=15m
REFRESH_TTL=168h
OTP_TTL=10m

# Gmail SMTP: use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Only used when the users table is empty. The account gets NO password: set it via "Forgot password".
BOOTSTRAP_ADMIN_EMAIL=
DATABASE_URL=               # postgres DSN; empty = local SQLite file
